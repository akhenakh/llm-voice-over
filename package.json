{
  "name": "opencode-voice-over",
  "version": "0.2.7",
  "type": "module",
  "description": "Spoken turn-end notifications for OpenCode and Claude Code, streamed through pdg",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:claude": "tsc --noEmit -p tsconfig.claude.json",
    "test:claude": "claude plugin test .",
    "validate:claude": "claude plugin validate .",
    "verify": "bun run typecheck && bun run typecheck:claude && bun test src && bun run validate:claude && bun run test:claude"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-code",
    "claude-code-plugin",
    "tts",
    "pdg"
  ],
  "dependencies": {
    "@opencode/plugin": "^2.1.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
